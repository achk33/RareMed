# RareMed AI Version 0.3
# Copy this file to .env at the repository root before a host-side run.
# Docker Compose sets service hostnames itself and does not require this file.
# These passwords are for local development only.

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Host-side API. Inside Compose the hostname is "postgres", not localhost.
DATABASE_URL=postgresql+psycopg://raremed:raremed@localhost:5432/raremed
POSTGRES_USER=raremed
POSTGRES_PASSWORD=raremed
POSTGRES_DB=raremed

# Host-side Bolt URL. Inside Compose this is bolt://neo4j:7687.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=raremed-neo4j
NEO4J_DATABASE=neo4j

# Ollama stays on the Windows host. The default model is qwen3:4b in
# backend/app/ai/model.json (temperature, num_ctx, think).
# Host process:  http://localhost:11434
# Backend container: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=2
# Optional overrides. Leave unset to use model.json.
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_THINK=false
# MODEL_TEMPERATURE=0.6
# MODEL_NUM_CTX=4096
# INFERENCE_PROVIDER=ollama
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# VLLM_BASE_URL=
# VLLM_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional first admin. Registration always creates a user account.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-password

# Leave empty to use the repository data/ directory.
DATA_ROOT=

# Browser-facing API URL baked into the frontend at dev/build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
